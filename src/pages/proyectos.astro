import Footer from '../components/Footer.jsx';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Proyectos — Periferia Subversivx</title>
    
    <!-- Fuentes de Google -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700&family=Patrick+Hand+SC&family=Rubik:wght@900&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">


    <!-- Estilos globales y de componentes -->
    <link rel="stylesheet" href="/style/global.css" />
    <link rel="stylesheet" href="/style/header.css" />
    <link rel="stylesheet" href="/style/proyectos.css" />
    <link rel="stylesheet" href="/style/contact.css" />
    <link rel="stylesheet" href="/style/footer.css" />
  </head>
  <body>
    <Header client:load />
    <main>
